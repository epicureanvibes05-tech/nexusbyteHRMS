generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EmployeeStatus {
  PROBATION
  CONFIRMED
  ACTIVE
  NOTICE_PERIOD
  EXITED
  TERMINATED
}

enum SalaryType {
  BASIC_SALARY
  NO_BASIC_SALARY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  code        String? @unique @db.VarChar(20)
  description String? @db.Text
  isActive    Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  code        String? @unique @db.VarChar(20)
  description String? @db.Text
  isActive    Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  startTime String @db.VarChar(5)
  endTime   String @db.VarChar(5)

  graceMinutes Int @default(10)

  breakAllowed      Boolean @default(true)
  breakStartTime    String? @db.VarChar(5)
  breakEndTime      String? @db.VarChar(5)
  breakGraceMinutes Int     @default(0)

  isActive Boolean @default(true)

  weeklyOffs ShiftWeeklyOff[]
  employees  Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftWeeklyOff {
  id        Int       @id @default(autoincrement())
  shiftId   Int
  dayOfWeek DayOfWeek

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([shiftId, dayOfWeek])
  @@index([shiftId])
}

model Employee {
  id Int @id @default(autoincrement())

  employeeCode String @unique @db.VarChar(30)

  employeeName        String  @db.VarChar(150)
  officialEnglishName String? @db.VarChar(150)
  fatherName          String? @db.VarChar(150)

  cnic        String?   @unique @db.VarChar(30)
  dateOfBirth DateTime? @db.Date

  personalPhone    String? @db.VarChar(30)
  email            String? @db.VarChar(150)
  address          String? @db.Text
  emergencyContact String? @db.VarChar(100)

  profilePhotoUrl String? @db.VarChar(500)

  joiningDate          DateTime @db.Date
  systemEnrollmentDate DateTime @default(now())

  employmentStatus EmployeeStatus @default(PROBATION)

  probationMonths  Int       @default(2)
  probationEndDate DateTime? @db.Date

  salaryType          SalaryType @default(BASIC_SALARY)
  currentBasicSalary  Decimal?   @db.Decimal(12, 2)
  salaryEffectiveDate DateTime?  @db.Date

  savingsEnabled              Boolean @default(true)
  punctualityDeductionEnabled Boolean @default(true)
  leaveDeductionEnabled       Boolean @default(true)
  halfDayDeductionEnabled     Boolean @default(true)
  absenceDeductionEnabled     Boolean @default(true)
  dockFineEnabled             Boolean @default(true)
  otherFineEnabled            Boolean @default(true)

  departmentId  Int?
  designationId Int?
  shiftId       Int?

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  salaryHistory SalaryHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([designationId])
  @@index([shiftId])
  @@index([employmentStatus])
  @@index([joiningDate])
}

model SalaryHistory {
  id Int @id @default(autoincrement())

  employeeId Int

  previousSalary Decimal? @db.Decimal(12, 2)
  newSalary      Decimal? @db.Decimal(12, 2)

  effectiveDate DateTime @db.Date

  reason  String? @db.VarChar(255)
  remarks String? @db.Text

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
}

model User {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)
  email    String  @unique @db.VarChar(150)
  username String? @unique @db.VarChar(100)

  passwordHash String @db.VarChar(255)

  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  userRoles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  code        String  @unique @db.VarChar(100)
  description String? @db.Text

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String? @db.Text
  module      String  @db.VarChar(100)

  roleLinks RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Tenant {
  id       Int     @id @default(autoincrement())
  slug     String  @unique @db.VarChar(100)
  name     String  @db.VarChar(150)
  isActive Boolean @default(true)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Company {
  id                Int     @id @default(autoincrement())
  tenantId          Int
  code              String  @db.VarChar(20)
  name              String  @db.VarChar(150)
  isActive          Boolean @default(true)
  currentSettingsId Int?

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  settings        CompanySettings[] @relation("CompanySettingsHistory")
  currentSettings CompanySettings?  @relation("CurrentCompanySettings", fields: [tenantId, id, currentSettingsId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, id, currentSettingsId])
  @@index([tenantId, isActive])
}

// Append-only versions; publication, overlap checks and audit belong to a later service slice.
model CompanySettings {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  companyId Int
  version   Int
  timezone  String    @db.VarChar(100)
  currency  String    @db.Char(3)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date

  company           Company  @relation("CompanySettingsHistory", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  currentForCompany Company? @relation("CurrentCompanySettings")

  createdAt DateTime @default(now())

  @@unique([tenantId, companyId, id])
  @@unique([tenantId, companyId, version])
  @@index([tenantId, companyId, validFrom])
}
